# Copy this file to .env and fill in ONE provider. .env is gitignored: never commit a key.
# A model is used by one check of milestones 3 and 4, the last check of d1 to d5, and two checks of d8.
# Milestones 1, 2 and 5, d6 and d7 need none of this. `uv run trail llm` checks the setup.
#
# Cost: an agent check (d1 to d5, d8) runs your agent on a whole pack of requests, so it makes dozens of
# calls per check. A smaller model costs much less than the default one. `uv run trail check d4 --no-llm`
# skips the model checks while you work on the rest, and every `check` that used a model ends with an
# "LLM use:" line. Set TRAIL_LLM_CACHE=0 to bypass the answer cache in .trail-cache/llm.

# Where the project's LLM calls go: anthropic, openai, fireworks or openrouter.
TRAIL_LLM_PROVIDER=anthropic

# The model, written exactly as your provider's model list writes it.
# Optional for anthropic (default: claude-opus-5-5, the most capable and the most expensive); required for
# openai, fireworks and openrouter. The agent milestones need a model that calls tools.
# Fireworks ids look like accounts/fireworks/models/<model>; OpenRouter ids like <vendor>/<model>.
TRAIL_LLM_MODEL=

# Claude only, optional: how much the model thinks before answering (low, medium, high, xhigh, max).
TRAIL_LLM_EFFORT=

# The key of the provider you picked. Leave the others commented out.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# FIREWORKS_API_KEY=
# OPENROUTER_API_KEY=

# Neo4j, for milestone 4 only (`docker compose up -d` starts it with these defaults). Neo4j keeps the
# password it was first started with: change it here before the first start (README.md, Troubleshooting).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trail-password
